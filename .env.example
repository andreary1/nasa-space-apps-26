# Copie este arquivo para .env (na raiz do repositório) e coloque sua chave.
# O .env está no .gitignore: a chave nunca vai para o GitHub nem para o front.

# Provedor: gemini | groq | openrouter
AI_PROVIDER=gemini

# Chave criada em https://aistudio.google.com (Gemini) ou no painel do provedor escolhido
AI_API_KEY=coloque_sua_chave_aqui

# Opcional: modelo. Padrões: gemini -> gemini-3.1-flash-lite, groq -> openai/gpt-oss-120b
# No openrouter é obrigatório (ex.: um modelo terminado em :free)
# AI_MODEL=

# Opcional: endpoint próprio compatível com a OpenAI (sobrescreve o do provedor)
# AI_BASE_URL=

# Opcional: modelos reserva, separados por vírgula, usados se o principal estiver sobrecarregado (HTTP 503)
# Reserva padrão: gemini-3.5-flash (testado).
# AI_FALLBACK_MODELS=

# Opcional: reasoning_effort. Gemini usa vazio por padrão.
# AI_REASONING_EFFORT=

# Opcional: tempo máximo por chamada, em ms
# AI_TIMEOUT_MS=30000
# AI_TOTAL_TIMEOUT_MS=70000

# Opcional: pausa entre localidades, em ms, para respeitar o limite do plano grátis
# AI_DELAY_MS=4000

# Análise Inteligente: o servidor Node existente chama este Python (sem expor chaves).
# ANALYSIS_PYTHON=C:\Users\seu_usuario\AppData\Local\PlanetaryAnalogFinder\venv\Scripts\python.exe
# Fonte: local | copernicus-public (padrão, sem chave) | opentopography
# ANALYSIS_DEM_PROVIDER=copernicus-public
# OPENTOPOGRAPHY_API_KEY=
# Opcional: GeoTIFF/HGT de ELEVAÇÃO em metros, separados por ; no Windows.
# ANALYSIS_DEM_PATHS=C:\dados\dem.tif
# ANALYSIS_CACHE_DIR=C:\dados\paf-cache
# Resolução métrica de processamento (10 a 100 m; padrão 30). Não melhora a resolução nativa.
# ANALYSIS_RESOLUTION_M=30
# Registro opcional e REVISADO de feições delimitadas/medições (alternativa ao extrator).
# ANALYSIS_FEATURES_FILE=C:\dados\evidencias-revisadas.json
# Limiares EXPERIMENTAIS, não critérios científicos validados (0 a 1).
# ANALYSIS_MIN_SCORE=0.8
# ANALYSIS_MIN_COVERAGE=0.8

# Pesquisa Gemini: 1 (padrão) habilita Google Search; 0 desabilita chamadas de pesquisa.
# Grounding pode gerar custos. Até 1 chamada Gemini por análise, 12 chamadas/hora/servidor.
# ANALYSIS_DISCOVERY_ENABLED=1
# Catálogos científicos independentes (1 por padrão), mesmo com pesquisa Gemini desabilitada.
# ANALYSIS_CATALOG_ENABLED=1
# Modelo de pesquisa separado opcional; padrão mantém o Gemini já configurado.
# GEMINI_SEARCH_MODEL=gemini-3.1-flash-lite
# Chave Gemini separada opcional; padrão reutiliza AI_API_KEY somente se AI_PROVIDER=gemini.
# GEMINI_SEARCH_API_KEY=
